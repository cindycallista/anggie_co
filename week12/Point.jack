/** 測試 constructor、field、method、陣列、字串、if/while */
class Point {
    field int x, y;
    static int count;

    constructor Point new(int ax, int ay) {
        let x = ax;
        let y = ay;
        let count = count + 1;
        return this;
    }

    method int sum() { return x + y; }

    method void shift(int dx) {
        let x = x + dx;
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
